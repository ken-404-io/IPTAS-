# PostgreSQL connection string (Neon, Render Postgres, or local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# Clockify API key of a workspace admin (Clockify -> Profile settings -> API -> Generate)
CLOCKIFY_API_KEY=
# Optional: a specific Clockify workspace ID (default: the key owner's active workspace)
CLOCKIFY_WORKSPACE_ID=
# Optional: only for Clockify workspaces on a regional server, e.g. https://euc1.clockify.me/api/v1
CLOCKIFY_API_URL=

# Business details shown in the app and on reports
COMPANY_NAME=Northern Goods Co.
STOREFRONT_URL=https://www.shopify.com
# Business time zone: Clockify hours are put on the work date in this zone
TIMEZONE=America/Toronto
# Default USD to CAD rate offered when computing payroll
FX_USD_TO_CAD=1.37

# Optional: enables "Sign in with Google" (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, Web application)
GOOGLE_CLIENT_ID=

# Optional: pay employees by email with PayPal Payouts (developer.paypal.com -> Apps & Credentials -> your app)
# PAYPAL_ENV is "sandbox" (test money, default) or "live"
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
